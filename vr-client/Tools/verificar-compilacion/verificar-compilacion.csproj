<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compila todos los scripts de Assets/Scripts (runtime y editor) y las pruebas de Assets/Tests contra firmas mínimas de la API de Unity
    (Stubs/), sin Unity ni licencia. Atrapa errores de sintaxis, tipos y nombres antes de abrir el editor.
    C# 9 y .NET Standard 2.1: lo mismo que acepta Unity 6.
      dotnet build -warnaserror
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>XRLab.VerificarCompilacion</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Stubs/**/*.cs" />
    <Compile Include="../../Assets/Scripts/**/*.cs" LinkBase="Scripts" />
    <Compile Include="../../Assets/Tests/**/*.cs" LinkBase="Tests" />
  </ItemGroup>
</Project>
